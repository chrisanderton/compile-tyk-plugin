# syntax=docker/dockerfile:1.7
# Lean PROOF image: validates the modern base (cross toolchains + glibc sysroots + build.sh
# + validator) WITHOUT the heavy Gateway vendoring. It is literally the production BASE image
# plus a Go toolchain - so it exercises the EXACT sysroots/toolchain the real compiler uses,
# with NO second, drift-prone sysroot definition. The glibc floor is whatever the base was
# built with: 2.17 (RHEL 7 / CentOS 7) by default, matching the compiler's compat posture;
# build the base with GLIBC_TARGET=2.31 to proof the opt-in higher floor.
#
#   docker build -f Dockerfile.base  -t compile-tyk-plugin-base:proof .         # 2.17 default
#   docker build -f Dockerfile.proof --build-arg COMPILER_BASE_IMAGE=compile-tyk-plugin-base:proof \
#                -t tyk-plugin-compiler:proof .
#   ./scripts/validate-proof.sh
ARG COMPILER_BASE_IMAGE=compile-tyk-plugin-base:proof
ARG BASE_IMAGE=dhi.io/debian-base:trixie-debian13-dev
ARG GO_VERSION=1.25.10

# ---- pinned Go toolchain (the only thing the base deliberately omits) ------
FROM ${BASE_IMAGE} AS gotool
ARG GO_VERSION
ARG TARGETARCH
ARG GO_SHA256_amd64=42d4f7a32316aa66591eca7e89867256057a4264451aca10570a715b3637ba70
ARG GO_SHA256_arm64=654da1f9b50a5d1c2a85ccf8ed405aa89c06e94d18384628bf186f7712677b08
RUN set -eux; apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*; \
    case "${TARGETARCH}" in amd64) sha="${GO_SHA256_amd64}";; arm64) sha="${GO_SHA256_arm64}";; *) exit 1;; esac; \
    curl -fsSL --retry 5 --retry-all-errors --retry-delay 3 --connect-timeout 30 \
      "https://go.dev/dl/go${GO_VERSION}.linux-${TARGETARCH}.tar.gz" -o /tmp/go.tgz; \
    echo "${sha}  /tmp/go.tgz" | sha256sum -c -; \
    mkdir -p /usr/local; tar -C /usr/local -xzf /tmp/go.tgz; rm /tmp/go.tgz

# ---- proof = base (sysroots + cross gcc + build.sh + validator + env) + Go ----
FROM ${COMPILER_BASE_IMAGE} AS proof
COPY --from=gotool /usr/local/go /usr/local/go
# the base sets ENTRYPOINT ["/build.sh"]; the proof harness invokes bash directly, so reset it.
ENTRYPOINT []
WORKDIR /src
